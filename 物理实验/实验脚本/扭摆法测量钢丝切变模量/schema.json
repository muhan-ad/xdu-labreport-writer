{
  "实验": "扭摆法测量钢丝切变模量",
  "groups": [
    {
      "name": "转动周期测量（每次测 30 个周期总时间，5 次）",
      "fields": [
        {
          "key": "t_disk",
          "label": "摆盘转动时间",
          "type": "array",
          "length": 5,
          "unit": "s",
          "required": true,
          "default": null
        },
        {
          "key": "t_ring",
          "label": "摆盘+圆环转动时间",
          "type": "array",
          "length": 5,
          "unit": "s",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "钢丝直径测量（千分尺）",
      "fields": [
        {
          "key": "d_zero",
          "label": "零误差 d₀",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null
        },
        {
          "key": "d_horiz",
          "label": "横向直径 d（3 位置）",
          "type": "array",
          "length": 3,
          "unit": "mm",
          "required": true,
          "default": null
        },
        {
          "key": "d_vert",
          "label": "纵向直径 d（3 位置）",
          "type": "array",
          "length": 3,
          "unit": "mm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "单次测量量",
      "fields": [
        {
          "key": "l_mm",
          "label": "钢丝长度 l",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null
        },
        {
          "key": "D1_mm",
          "label": "圆环内径 D₁",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null
        },
        {
          "key": "D2_mm",
          "label": "圆环外径 D₂",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null
        },
        {
          "key": "m_g",
          "label": "圆环质量 m",
          "type": "number",
          "unit": "g",
          "default": null,
          "required": true
        }
      ]
    },
    {
      "name": "实际仪器参数（不使用教材或示例数值）",
      "fields": [
        {
          "key": "instrument_delta_timer",
          "label": "计时器仪器限差（按实际仪器填写）",
          "type": "number",
          "unit": "s",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_TIMER"
        },
        {
          "key": "instrument_delta_micrometer",
          "label": "千分尺仪器限差（按实际仪器填写）",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_MICROMETER"
        },
        {
          "key": "instrument_delta_ruler",
          "label": "长度量具仪器限差（按实际仪器填写）",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_RULER"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "userInputOnly": true
}
