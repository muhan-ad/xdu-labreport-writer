{
  "实验": "刚体转动惯量的测量",
  "groups": [
    {
      "name": "已知量",
      "fields": [
        {
          "key": "m0_g",
          "label": "下盘质量 m₀",
          "type": "number",
          "unit": "g",
          "default": null,
          "required": true
        },
        {
          "key": "m_g",
          "label": "圆环质量 m",
          "type": "number",
          "unit": "g",
          "default": null,
          "required": true
        }
      ]
    },
    {
      "name": "测量数据（7 量 × 5 次）",
      "fields": [
        {
          "key": "measurements",
          "label": "测量值（行序：r/cm、R/cm、T₀/s、H/cm、d/cm、D/cm、T/s）",
          "type": "matrix",
          "rows": 7,
          "cols": 5,
          "rowLabels": [
            "r/cm",
            "R/cm",
            "T₀/s",
            "H/cm",
            "d/cm",
            "D/cm",
            "T/s"
          ],
          "colLabels": [
            "第1次",
            "第2次",
            "第3次",
            "第4次",
            "第5次"
          ],
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "仪器参数",
      "fields": [
        {
          "key": "instrument_g",
          "label": "当地重力加速度",
          "type": "number",
          "unit": "m/s²",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "g"
        },
        {
          "key": "instrument_delta_ruler",
          "label": "长度量具仪器限差",
          "type": "number",
          "unit": "cm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_RULER"
        },
        {
          "key": "instrument_delta_timer",
          "label": "计时器仪器限差",
          "type": "number",
          "unit": "s",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_TIMER"
        },
        {
          "key": "instrument_delta_balance",
          "label": "天平仪器限差",
          "type": "number",
          "unit": "g",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_BALANCE"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "userInputOnly": true
}
