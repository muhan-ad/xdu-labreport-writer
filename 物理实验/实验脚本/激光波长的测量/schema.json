{
  "实验": "激光波长的测量",
  "groups": [
    {
      "name": "光源给定参数",
      "fields": [
        {
          "key": "lambda0_nm",
          "label": "激光标称波长 λ₀（用于比较）",
          "type": "number",
          "unit": "nm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "presets": [
            {
              "label": "He–Ne 红光 632.8 nm",
              "value": 632.8
            },
            {
              "label": "红光激光器 650 nm",
              "value": 650
            }
          ]
        }
      ]
    },
    {
      "name": "测量数据（8 次 × 2 列：l₁、l₂）",
      "fields": [
        {
          "key": "measurements",
          "label": "反射镜位置读数 l₁、l₂",
          "type": "matrix",
          "rows": 8,
          "cols": 2,
          "rowLabels": [
            "第1次",
            "第2次",
            "第3次",
            "第4次",
            "第5次",
            "第6次",
            "第7次",
            "第8次"
          ],
          "colLabels": [
            "l₁",
            "l₂"
          ],
          "unit": "mm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "已知量",
      "fields": [
        {
          "key": "N",
          "label": "冒出（缩进）条纹数 N",
          "type": "number",
          "default": null,
          "required": true
        }
      ]
    },
    {
      "name": "仪器参数",
      "fields": [
        {
          "key": "instrument_delta_inst_mm",
          "label": "位移仪器限差",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_INST_MM"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "userInputOnly": true
}
