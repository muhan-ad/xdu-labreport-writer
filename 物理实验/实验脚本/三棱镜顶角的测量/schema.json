{
  "实验": "三棱镜顶角的测量",
  "groups": [
    {
      "name": "游标方位角读数（4 组 × 8 列，度/分交替）",
      "fields": [
        {
          "key": "readings",
          "label": "θA、θB、θ′A、θ′B 方位角读数（每个角分 度、分 两列）",
          "type": "matrix",
          "rows": 4,
          "cols": 8,
          "unit": "度/分",
          "required": true,
          "rowLabels": [
            "第1组",
            "第2组",
            "第3组",
            "第4组"
          ],
          "colLabels": [
            "θA 度",
            "θA 分",
            "θB 度",
            "θB 分",
            "θ′A 度",
            "θ′A 分",
            "θ′B 度",
            "θ′B 分"
          ],
          "default": null
        }
      ]
    },
    {
      "name": "实际仪器参数（不使用教材或示例数值）",
      "fields": [
        {
          "key": "instrument_delta_instr_min",
          "label": "分光计仪器限差（按实际仪器填写）",
          "type": "number",
          "unit": "角分",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_INSTR_MIN"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "userInputOnly": true
}
