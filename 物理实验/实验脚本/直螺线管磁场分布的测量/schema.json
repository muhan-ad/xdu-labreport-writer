{
  "实验": "直螺线管磁场分布的测量",
  "groups": [
    {
      "name": "已知参数（可按实际修改）",
      "fields": [
        {
          "key": "M_mH",
          "label": "互感系数 M",
          "type": "number",
          "unit": "mH",
          "default": null,
          "required": true
        },
        {
          "key": "N",
          "label": "螺线管总匝数 N",
          "type": "number",
          "default": null,
          "required": true
        },
        {
          "key": "l_m",
          "label": "螺线管长度 l",
          "type": "number",
          "unit": "m",
          "default": null,
          "required": true
        },
        {
          "key": "r0_m",
          "label": "螺线管半径 r₀",
          "type": "number",
          "unit": "m",
          "default": null,
          "required": true
        },
        {
          "key": "n_coil",
          "label": "探测线圈匝数 n",
          "type": "number",
          "default": null,
          "required": true
        },
        {
          "key": "S_m2",
          "label": "探测线圈截面积 S",
          "type": "number",
          "unit": "m²",
          "default": null,
          "required": true
        },
        {
          "key": "I_A",
          "label": "工作电流 I",
          "type": "number",
          "unit": "A",
          "default": null,
          "required": true
        },
        {
          "key": "R_ohm",
          "label": "回路总电阻 R",
          "type": "number",
          "unit": "Ω",
          "default": null,
          "required": true
        }
      ]
    },
    {
      "name": "表1 RKb 标定（冲击常数，3 组）",
      "fields": [
        {
          "key": "I0_ma",
          "label": "互感器初级电流 I₀",
          "type": "array",
          "length": 3,
          "unit": "mA",
          "required": true,
          "default": null
        },
        {
          "key": "dm1_cm",
          "label": "第一次偏转 dm₁",
          "type": "array",
          "length": 3,
          "unit": "cm",
          "required": true,
          "default": null
        },
        {
          "key": "dm2_cm",
          "label": "第二次偏转 dm₂",
          "type": "array",
          "length": 3,
          "unit": "cm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "表2 磁感应强度 B 测量（16 个测点）",
      "fields": [
        {
          "key": "x_mm",
          "label": "测点位置 x",
          "type": "array",
          "length": 16,
          "unit": "mm",
          "required": true,
          "default": null
        },
        {
          "key": "d_left_cm",
          "label": "左侧偏转 d左",
          "type": "array",
          "length": 16,
          "unit": "cm",
          "required": true,
          "default": null
        },
        {
          "key": "d_right_cm",
          "label": "右侧偏转 d右",
          "type": "array",
          "length": 16,
          "unit": "cm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "实际仪器参数（不使用教材或示例数值）",
      "fields": [
        {
          "key": "instrument_delta_ammeter_a",
          "label": "电流表仪器限差（按实际仪器填写）",
          "type": "number",
          "unit": "A",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_AMMETER_A"
        },
        {
          "key": "instrument_delta_scale_mm",
          "label": "标尺仪器限差（按实际仪器填写）",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_SCALE_MM"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "userInputOnly": true
}
