{
  "实验": "直螺线管磁场分布的测量",
  "groups": [
    {
      "name": "已知参数",
      "fields": [
        {
          "key": "M_mH",
          "label": "互感系数 M",
          "type": "number",
          "unit": "mH",
          "default": null,
          "required": true
        },
        {
          "key": "N",
          "label": "螺线管总匝数 N",
          "type": "number",
          "default": null,
          "required": true
        },
        {
          "key": "l_m",
          "label": "螺线管长度 l",
          "type": "number",
          "unit": "m",
          "default": null,
          "required": true
        },
        {
          "key": "r0_cm",
          "label": "螺线管半径 r₀",
          "type": "number",
          "unit": "cm",
          "default": null,
          "required": true,
          "legacyKey": "r0_m",
          "legacyScale": 100
        },
        {
          "key": "n_coil",
          "label": "探测线圈匝数 n",
          "type": "number",
          "default": null,
          "required": true
        },
        {
          "key": "S_m2",
          "label": "探测线圈截面积 S",
          "type": "number",
          "unit": "m²",
          "default": null,
          "required": true
        },
        {
          "key": "I_mA",
          "label": "工作电流 I",
          "type": "number",
          "unit": "mA",
          "default": null,
          "required": true,
          "legacyKey": "I_A",
          "legacyScale": 1000
        },
        {
          "key": "R_ohm",
          "label": "回路总电阻 R",
          "type": "number",
          "unit": "Ω",
          "default": null,
          "required": true
        }
      ]
    },
    {
      "name": "表1 RKb 标定（冲击常数，3 组）",
      "fields": [
        {
          "key": "I0_ma",
          "label": "互感器初级电流 I₀",
          "type": "array",
          "length": 3,
          "unit": "mA",
          "required": true,
          "default": null
        },
        {
          "key": "dm1_cm",
          "label": "第一次偏转 dm₁",
          "type": "array",
          "length": 3,
          "unit": "cm",
          "required": true,
          "default": null
        },
        {
          "key": "dm2_cm",
          "label": "第二次偏转 dm₂",
          "type": "array",
          "length": 3,
          "unit": "cm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "表2 磁感应强度 B 测量（16 个测点）",
      "fields": [
        {
          "key": "x_mm",
          "label": "测点位置 x",
          "type": "array",
          "length": 16,
          "unit": "mm",
          "required": true,
          "default": null
        },
        {
          "key": "d_left_cm",
          "label": "左侧纵坐标 dₘ₁（x≤0）",
          "type": "array",
          "length": 16,
          "unit": "cm",
          "required": true,
          "default": null
        },
        {
          "key": "d_right_cm",
          "label": "右侧纵坐标 dₘ₂（x≥0）",
          "type": "array",
          "length": 16,
          "unit": "cm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "仪器参数",
      "fields": [
        {
          "key": "instrument_delta_ammeter_a",
          "label": "电流表仪器限差",
          "type": "number",
          "unit": "A",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_AMMETER_A"
        },
        {
          "key": "instrument_delta_scale_mm",
          "label": "标尺仪器限差",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_SCALE_MM"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "userInputOnly": true
}
