{
  "实验": "拉伸法测量钢丝杨氏弹性模量",
  "groups": [
    {
      "name": "实验参数",
      "fields": [
        {
          "key": "L",
          "label": "钢丝长度 L",
          "type": "number",
          "unit": "m",
          "default": null,
          "required": true
        },
        {
          "key": "D",
          "label": "光杠杆常数 D",
          "type": "number",
          "unit": "mm",
          "default": null,
          "required": true
        },
        {
          "key": "H",
          "label": "镜面到标尺距离 H",
          "type": "number",
          "unit": "m",
          "default": null,
          "required": true
        },
        {
          "key": "d_0",
          "label": "螺旋测微计零点修正 d₀",
          "type": "number",
          "unit": "mm",
          "default": null,
          "required": true
        }
      ]
    },
    {
      "name": "钢丝直径（螺旋测微计，6 次）",
      "fields": [
        {
          "key": "d_shi",
          "label": "钢丝直径 d",
          "type": "array",
          "length": 6,
          "unit": "mm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "光杠杆标尺读数（8 次）",
      "fields": [
        {
          "key": "ni_zheng",
          "label": "增重 n_i",
          "type": "array",
          "length": 8,
          "unit": "cm",
          "required": true,
          "default": null
        },
        {
          "key": "ni_jian",
          "label": "减重 n_i",
          "type": "array",
          "length": 8,
          "unit": "cm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "实际仪器参数（不使用教材或示例数值）",
      "fields": [
        {
          "key": "instrument_g",
          "label": "当地重力加速度（按实际仪器填写）",
          "type": "number",
          "unit": "m/s²",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "G"
        },
        {
          "key": "instrument_d_inst_err",
          "label": "直径测量仪器限差（按实际仪器填写）",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "D_INST_ERR"
        },
        {
          "key": "instrument_delta_L",
          "label": "钢丝长度 L 测量限差",
          "type": "number",
          "unit": "m",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_L_M",
          "hint": "按实际仪器限差填写，按均匀分布换算为标准不确定度。"
        },
        {
          "key": "instrument_delta_H",
          "label": "光杠杆长度 H 测量限差",
          "type": "number",
          "unit": "m",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_H_M",
          "hint": "按实际仪器限差填写，按均匀分布换算为标准不确定度。"
        },
        {
          "key": "instrument_delta_D",
          "label": "标尺距离 D 测量限差",
          "type": "number",
          "unit": "mm",
          "required": true,
          "default": null,
          "exclusiveMinimum": 0,
          "bindConstant": "DELTA_D_MM",
          "hint": "按实际仪器限差填写，按均匀分布换算为标准不确定度。"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "userInputOnly": true
}
