{
  "实验": "重力加速度的测量",
  "groups": [
    {
      "name": "实验参数",
      "fields": [
        {
          "key": "g0",
          "label": "当地重力加速度参考值 g₀",
          "type": "number",
          "unit": "m/s²",
          "default": null,
          "required": true,
          "exclusiveMinimum": 0
        },
        {
          "key": "delta_instr",
          "label": "秒表 Δ仪",
          "type": "number",
          "unit": "s",
          "default": null,
          "minimum": 0,
          "maximum": 0.1,
          "required": true
        }
      ]
    },
    {
      "name": "测量数据（横向 9 孔 × 纵向 8 次）",
      "fields": [
        {
          "key": "pivot",
          "label": "支点位置",
          "type": "array",
          "length": 9,
          "unit": "cm",
          "required": true,
          "default": null
        },
        {
          "key": "trials",
          "label": "10周期测量值",
          "type": "matrix",
          "rows": 9,
          "cols": 8,
          "displayTranspose": true,
          "rowLabels": [
            "第1孔",
            "第2孔",
            "第3孔",
            "第4孔",
            "第5孔",
            "第6孔",
            "第7孔",
            "第8孔",
            "第9孔"
          ],
          "colLabels": [
            "第1次",
            "第2次",
            "第3次",
            "第4次",
            "第5次",
            "第6次",
            "第7次",
            "第8次"
          ],
          "unit": "s",
          "ocrTranspose": true,
          "ocrHint": "照片通常是8行测量次数×9列孔位；输出必须转成9行孔位×8列次数。第9孔整列必须保留；不要把单周期平均行混入此矩阵。",
          "required": true,
          "default": null
        },
        {
          "key": "T_avg",
          "label": "单周期平均 T（第1～9孔）",
          "type": "array",
          "length": 9,
          "unit": "s",
          "fallbackDivisor": 10,
          "ocrHint": "抄录照片最下面的「单周期平均」行，按第1孔到第9孔从左到右给9个数；不要根据10周期数据推算。",
          "required": true,
          "default": null
        },
        {
          "key": "h",
          "label": "h（摆轴离中心距离）",
          "type": "array",
          "length": 9,
          "unit": "cm",
          "required": true,
          "default": null
        }
      ]
    },
    {
      "name": "可选",
      "fields": [
        {
          "key": "cm_position",
          "label": "质心位置",
          "type": "number",
          "unit": "cm",
          "required": true,
          "default": null
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "userInputOnly": true
}
