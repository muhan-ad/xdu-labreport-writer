{
  "name": "labreport-writer",
  "version": "2.2.0",
  "description": "大学物理实验报告自动编写应用",
  "main": "main.js",
  "scripts": {
    "test": "node scripts/verify.js",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "verify": "node scripts/verify.js",
    "test:desktop": "node scripts/test-desktop.js",
    "test:course": "python-runtime\\python.exe -m unittest discover -s src/course-selection -p test_*.py && node --test src/course-selection/test_*.cjs"
  },
  "keywords": [
    "物理实验",
    "报告生成",
    "Electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "docx-preview": "^0.4.0",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "mammoth": "^1.12.2",
    "sanitize-html": "2.17.7"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-pack.cjs",
    "appId": "com.labreport.writer",
    "productName": "实验搭子",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "!src/.mimosa/**",
      "!src/course-selection/test*",
      "!src/course-selection/__pycache__/**",
      "!src/course-selection/bridge*"
    ],
    "extraResources": [
      {
        "from": "python-runtime",
        "to": "python-runtime"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "物理实验",
        "to": "物理实验",
        "filter": [
          "**/*",
          "!**/*.xlsx",
          "!**/*.xls",
          "!**/*.docx",
          "!**/*.png",
          "!**/.lab_sections.json",
          "!**/__pycache__/**",
          "!**/.mimosa/**"
        ]
      },
      {
        "from": "src/course-selection",
        "to": "course-selection",
        "filter": [
          "server.py",
          "academic.py",
          "course_metadata.py",
          "academic_reader.cjs",
          "edge_reader.cjs",
          "app.js",
          "index.html",
          "style.css",
          "academic_bridge.py",
          "timetable_reader.js",
          "guide-content.js",
          "guide-ui.js",
          "guide-reviews.js",
          "course-filters.js",
          "filter-ui.js",
          "cancellation.py",
          "guide-ui.css",
          "guide_selection.py",
          "audio/**/*"
        ]
      },
      {
        "from": "src/shared",
        "to": "shared",
        "filter": [
          "unified-select.js",
          "unified-select.css",
          "input-fields.css"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "实验搭子",
      "installerIcon": "src/icon.ico",
      "uninstallerIcon": "src/icon.ico"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
