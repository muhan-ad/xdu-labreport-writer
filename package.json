{
  "name": "labreport-writer",
  "version": "2.1.1",
  "description": "大学物理实验报告自动编写应用",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/regression.test.js tests/security.test.js tests/ocr.test.js",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "verify": "node scripts/verify.js",
    "test:desktop": "node scripts/test-desktop.js"
  },
  "keywords": [
    "物理实验",
    "报告生成",
    "Electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "docx-preview": "^0.4.0",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "mammoth": "^1.12.2",
    "sanitize-html": "2.17.7"
  },
  "build": {
    "appId": "com.labreport.writer",
    "productName": "实验搭子",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "!src/.mimosa/**"
    ],
    "extraResources": [
      {
        "from": "python-runtime",
        "to": "python-runtime"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "物理实验",
        "to": "物理实验",
        "filter": [
          "**/*",
          "!**/*.xlsx",
          "!**/*.xls",
          "!**/*.docx",
          "!**/*.png",
          "!**/.lab_sections.json",
          "!**/__pycache__/**",
          "!**/.mimosa/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "实验搭子",
      "installerIcon": "src/icon.ico",
      "uninstallerIcon": "src/icon.ico"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
