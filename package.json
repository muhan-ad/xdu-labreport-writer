{
  "name": "lab-maker-app",
  "version": "0.138.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/sync-report-assets.mjs && tsc --noEmit && vite build && node scripts/build-web-integrity.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "sync:android": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "test:reports": "node scripts/test-report-runtime.mjs --all",
    "test:science": "node scripts/test-science.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@noble/ed25519": "3.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "linkedom": "^0.18.12",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
